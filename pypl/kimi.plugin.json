{
  "name": "pypl",
  "version": "0.1.0",
  "description": "PayPal (PYPL) 持续研究插件，用于长程智能体工作流演示。",
  "commands": "./commands/",
  "skills": "./skills/",
  "agents": "./agents/",
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "^(Write|Edit|Bash|FetchURL)$",
      "command": "python3 ./hooks/pre_tool_use.py",
      "timeout": 5
    }
  ],
  "sessionStart": {
    "skill": "start"
  }
}
